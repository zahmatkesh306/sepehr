const token = localStorage.getItem('panel_token');
if (!token) window.location.href = '/login.html';

const authHeaders = {
  'Content-Type': 'application/json',
  Authorization: `Bearer ${token}`,
};

document.getElementById('logoutBtn').addEventListener('click', () => {
  localStorage.removeItem('panel_token');
  window.location.href = '/login.html';
});

async function api(path, options = {}) {
  const res = await fetch(path, { ...options, headers: authHeaders });
  if (res.status === 401) {
    localStorage.removeItem('panel_token');
    window.location.href = '/login.html';
    return;
  }
  if (res.status === 204) return null;
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || 'خطا');
  return data;
}

async function loadSettings() {
  const s = await api('/api/settings');
  document.getElementById('domain').value = s.domain || '';
}

document.getElementById('settingsForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  await api('/api/settings', {
    method: 'PUT',
    body: JSON.stringify({
      domain: document.getElementById('domain').value,
    }),
  });
  alert('تنظیمات ذخیره شد و لینک‌های کاربران بر همین اساس ساخته می‌شوند.');
});

function renderClients(clients) {
  const body = document.getElementById('clientsBody');
  body.innerHTML = '';

  clients.forEach((c) => {
    const tr = document.createElement('tr');
    tr.className = 'border-b border-slate-700/50';

    const statusBadge = c.enabled
      ? '<span class="px-2 py-0.5 rounded-full bg-emerald-600/20 text-emerald-400 text-xs">فعال</span>'
      : '<span class="px-2 py-0.5 rounded-full bg-red-600/20 text-red-400 text-xs">غیرفعال</span>';

    const subUrl = `${window.location.origin}/sub/${c.subToken}`;

    tr.innerHTML = `
      <td class="py-2">${c.name}</td>
      <td class="uppercase">${c.protocol}</td>
      <td>${statusBadge}</td>
      <td>${c.expiresAt ? c.expiresAt.slice(0, 10) : '—'}</td>
      <td>
        <button class="text-indigo-400 hover:underline text-xs copy-btn" data-value="${c.link}">کپی لینک</button>
      </td>
      <td>
        <button class="text-indigo-400 hover:underline text-xs copy-btn" data-value="${subUrl}">کپی سابسکریپشن</button>
      </td>
      <td class="space-x-2 space-x-reverse">
        <button class="text-yellow-400 hover:underline text-xs toggle-btn" data-id="${c.id}" data-enabled="${c.enabled}">
          ${c.enabled ? 'غیرفعال کن' : 'فعال کن'}
        </button>
        <button class="text-red-400 hover:underline text-xs delete-btn" data-id="${c.id}">حذف</button>
      </td>
    `;
    body.appendChild(tr);
  });

  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(btn.dataset.value);
      btn.textContent = 'کپی شد ✓';
      setTimeout(() => (btn.textContent = btn.dataset.value.startsWith('http') ? 'کپی سابسکریپشن' : 'کپی لینک'), 1500);
    });
  });

  document.querySelectorAll('.toggle-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const enabled = btn.dataset.enabled === 'true';
      await api(`/api/clients/${btn.dataset.id}`, {
        method: 'PATCH',
        body: JSON.stringify({ enabled: !enabled }),
      });
      loadClients();
    });
  });

  document.querySelectorAll('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('این کاربر حذف شود؟')) return;
      await api(`/api/clients/${btn.dataset.id}`, { method: 'DELETE' });
      loadClients();
    });
  });
}

async function loadClients() {
  const clients = await api('/api/clients');
  renderClients(clients);
}

document.getElementById('clientForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const name = document.getElementById('name').value;
  const protocol = document.getElementById('protocol').value;
  const expiresAt = document.getElementById('expiresAt').value || null;

  await api('/api/clients', {
    method: 'POST',
    body: JSON.stringify({ name, protocol, expiresAt }),
  });

  e.target.reset();
  loadClients();
});

loadSettings();
loadClients();

