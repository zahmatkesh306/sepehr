const { v4: uuidv4 } = require('uuid');
const crypto = require('crypto');

function newClientId() {
  return uuidv4(); // برای VLESS و VMess به عنوان id مصرف می‌شود
}

function newTrojanPassword() {
  return crypto.randomBytes(12).toString('hex'); // پسورد Trojan
}

function newSubToken() {
  return crypto.randomBytes(16).toString('hex'); // توکن لینک سابسکریپشن
}

module.exports = { newClientId, newTrojanPassword, newSubToken };

const { db } = require('../db');
const { WS_PATHS } = require('../xray/configBuilder');

function getDomain() {
  const s = db.get('settings').value();
  return s.domain || process.env.RAILWAY_PUBLIC_DOMAIN || 'YOUR-DOMAIN.up.railway.app';
}

// همه‌ی ترافیک از پورت 443 و روی wss (TLS واقعی توسط Railway انجام می‌شود)
const PUBLIC_PORT = 443;

function buildVlessLink(client) {
  const domain = getDomain();
  const params = `security=tls&type=ws&host=${domain}&path=${encodeURIComponent(WS_PATHS.vless)}&sni=${domain}`;
  return `vless://${client.uuid}@${domain}:${PUBLIC_PORT}?${params}#${encodeURIComponent(client.name)}`;
}

function buildVmessLink(client) {
  const domain = getDomain();
  const vmessObj = {
    v: '2',
    ps: client.name,
    add: domain,
    port: String(PUBLIC_PORT),
    id: client.uuid,
    aid: '0',
    net: 'ws',
    path: WS_PATHS.vmess,
    type: 'none',
    host: domain,
    tls: 'tls',
  };
  const encoded = Buffer.from(JSON.stringify(vmessObj)).toString('base64');
  return `vmess://${encoded}`;
}

function buildTrojanLink(client) {
  const domain = getDomain();
  const params = `security=tls&type=ws&host=${domain}&path=${encodeURIComponent(WS_PATHS.trojan)}&sni=${domain}`;
  return `trojan://${client.trojanPassword}@${domain}:${PUBLIC_PORT}?${params}#${encodeURIComponent(client.name)}`;
}

function buildClientLink(client) {
  if (client.protocol === 'vless') return buildVlessLink(client);
  if (client.protocol === 'vmess') return buildVmessLink(client);
  if (client.protocol === 'trojan') return buildTrojanLink(client);
  throw new Error('پروتکل ناشناخته');
}

function buildSubscriptionPayload(client) {
  const link = buildClientLink(client);
  return Buffer.from(link, 'utf-8').toString('base64');
}

module.exports = { buildClientLink, buildSubscriptionPayload };

const { db } = require('../db');

function isActive(client) {
  if (!client.enabled) return false;
  if (client.expiresAt && new Date(client.expiresAt).getTime() < Date.now()) return false;
  return true;
}

function buildVlessClients() {
  return db.get('clients')
    .filter((c) => c.protocol === 'vless' && isActive(c))
    .value()
    .map((c) => ({ id: c.uuid, email: c.name, level: 0 }));
}

function buildVmessClients() {
  return db.get('clients')
    .filter((c) => c.protocol === 'vmess' && isActive(c))
    .value()
    .map((c) => ({ id: c.uuid, email: c.name, level: 0, alterId: 0 }));
}

function buildTrojanClients() {
  return db.get('clients')
    .filter((c) => c.protocol === 'trojan' && isActive(c))
    .value()
    .map((c) => ({ password: c.trojanPassword, email: c.name, level: 0 }));
}

// پورت‌های داخلی ثابت (فقط روی 127.0.0.1، هرگز مستقیم به بیرون اکسپوز نمی‌شوند)
const INTERNAL_PORTS = { vless: 10001, vmess: 10002, trojan: 10003 };
// مسیرهای WebSocket که سرور Node جلوی آن‌ها ریورس‌پروکسی می‌کند
const WS_PATHS = { vless: '/vless-ws', vmess: '/vmess-ws', trojan: '/trojan-ws' };

/**
 * کانفیگ Xray برای اجرا پشت Railway (بدون TLS داخلی؛ ترافیک cleartext روی
 * لوکال‌هاست است چون TLS واقعی توسط لبه‌ی Railway انجام می‌شود).
 * سه اینباند مستقل روی WebSocket، هرکدام با یک پورت داخلی و مسیر جدا.
 */
function buildXrayConfig() {
  return {
    log: { loglevel: 'warning' },
    inbounds: [
      {
        tag: 'vless-in',
        listen: '127.0.0.1',
        port: INTERNAL_PORTS.vless,
        protocol: 'vless',
        settings: { clients: buildVlessClients(), decryption: 'none' },
        streamSettings: {
          network: 'ws',
          security: 'none',
          wsSettings: { path: WS_PATHS.vless },
        },
      },
      {
        tag: 'vmess-in',
        listen: '127.0.0.1',
        port: INTERNAL_PORTS.vmess,
        protocol: 'vmess',
        settings: { clients: buildVmessClients() },
        streamSettings: {
          network: 'ws',
          security: 'none',
          wsSettings: { path: WS_PATHS.vmess },
        },
      },
      {
        tag: 'trojan-in',
        listen: '127.0.0.1',
        port: INTERNAL_PORTS.trojan,
        protocol: 'trojan',
        settings: { clients: buildTrojanClients() },
        streamSettings: {
          network: 'ws',
          security: 'none',
          wsSettings: { path: WS_PATHS.trojan },
        },
      },
    ],
    outbounds: [
      { protocol: 'freedom', tag: 'direct' },
      { protocol: 'blackhole', tag: 'block' },
    ],
  };
}

module.exports = { buildXrayConfig, INTERNAL_PORTS, WS_PATHS };

const fs = require('fs');
const path = require('path');
const { spawn } = require('child_process');
const { buildXrayConfig } = require('./configBuilder');

const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, '..', '..', 'data');
const CONFIG_PATH = path.join(DATA_DIR, 'xray-config.json');
const XRAY_BIN = process.env.XRAY_BIN_PATH || 'xray';

let xrayProcess = null;

function writeConfig() {
  if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });
  const config = buildXrayConfig();
  fs.writeFileSync(CONFIG_PATH, JSON.stringify(config, null, 2), 'utf-8');
}

function startXray() {
  writeConfig();
  xrayProcess = spawn(XRAY_BIN, ['run', '-config', CONFIG_PATH], {
    stdio: ['ignore', 'pipe', 'pipe'],
  });

  xrayProcess.stdout.on('data', (d) => process.stdout.write(`[xray] ${d}`));
  xrayProcess.stderr.on('data', (d) => process.stderr.write(`[xray:err] ${d}`));

  xrayProcess.on('exit', (code, signal) => {
    console.log(`[xray] پروسه با کد ${code} (سیگنال ${signal}) متوقف شد`);
    xrayProcess = null;
  });

  console.log('[xray] پروسه اجرا شد.');
}

/**
 * بعد از هر تغییر در کاربران/تنظیمات، کانفیگ جدید نوشته و پروسه‌ی Xray
 * ری‌استارت می‌شود (چون Xray پشتیبانی از hot-reload کامل ندارد).
 */
function syncXray() {
  return new Promise((resolve) => {
    if (xrayProcess) {
      xrayProcess.once('exit', () => {
        startXray();
        resolve();
      });
      xrayProcess.kill('SIGTERM');
    } else {
      startXray();
      resolve();
    }
  });
}

module.exports = { startXray, syncXray };