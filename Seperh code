require('dotenv').config();
const path = require('path');
const http = require('http');
const express = require('express');

const { ensureAdmin } = require('./src/db');
const { startXray } = require('./src/xray/runner');
const { attachWsProxy } = require('./src/proxy');

const authRoutes = require('./src/routes/auth');
const { router: clientsRoutes, subscriptionHandler } = require('./src/routes/clients');
const settingsRoutes = require('./src/routes/settings');

ensureAdmin();

const app = express();
app.use(express.json());

// فایل‌های استاتیک داشبورد
app.use(express.static(path.join(__dirname, 'public')));

// API
app.use('/api/auth', authRoutes);
app.use('/api/clients', clientsRoutes);
app.use('/api/settings', settingsRoutes);

// لینک عمومی سابسکریپشن هر کاربر
app.get('/sub/:token', subscriptionHandler);

app.get('/health', (req, res) => res.json({ ok: true }));

// Railway پورت را از طریق متغیر PORT مشخص می‌کند
const PORT = process.env.PORT || 8080;

// از http.createServer خام استفاده می‌کنیم تا بتوانیم رویداد 'upgrade'
// (هندشیک وب‌ساکت VLESS/VMess/Trojan) را دستی به Xray فوروارد کنیم.
const server = http.createServer(app);
attachWsProxy(server);

server.listen(PORT, () => {
  console.log(`[panel] پنل روی پورت ${PORT} در حال اجراست`);
  startXray();
});

// خاموش کردن تمیز هنگام ری‌دیپلوی روی Railway
process.on('SIGTERM', () => {
  console.log('[panel] سیگنال SIGTERM دریافت شد، خاموش می‌شود...');
  server.close(() => process.exit(0));
});

const jwt = require('jsonwebtoken');

const SECRET = process.env.JWT_SECRET || 'insecure-dev-secret';

function signToken(payload) {
  return jwt.sign(payload, SECRET, { expiresIn: '12h' });
}

function requireAuth(req, res, next) {
  const header = req.headers.authorization || '';
  const token = header.startsWith('Bearer ') ? header.slice(7) : null;
  if (!token) return res.status(401).json({ error: 'توکن ارسال نشده است' });

  try {
    req.admin = jwt.verify(token, SECRET);
    next();
  } catch (err) {
    return res.status(401).json({ error: 'توکن نامعتبر یا منقضی‌شده' });
  }
}

module.exports = { signToken, requireAuth };

const fs = require('fs');
const path = require('path');
const bcrypt = require('bcryptjs');
const low = require('lowdb');
const FileSync = require('lowdb/adapters/FileSync');

// روی Railway باید DATA_DIR به یک Volume دائمی اشاره کند، وگرنه با هر
// دیپلوی جدید دیتابیس (کاربران) از بین می‌رود.
const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, '..', 'data');
if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });

const DB_PATH = path.join(DATA_DIR, 'db.json');
const adapter = new FileSync(DB_PATH);
const db = low(adapter);

// ساختار پیش‌فرض دیتابیس در اولین اجرا
db.defaults({
  admin: null,      // { username, passwordHash }
  clients: [],       // لیست کاربران VPN
  settings: {
    // دامنه‌ای که Railway به این سرویس داده (یا دامنه‌ی اختصاصی شما)
    domain: process.env.DOMAIN || process.env.RAILWAY_PUBLIC_DOMAIN || '',
  },
}).write();

// اگر ادمین هنوز ساخته نشده، از مقادیر .env بساز
function ensureAdmin() {
  const admin = db.get('admin').value();
  if (!admin) {
    const username = process.env.ADMIN_USERNAME || 'admin';
    const password = process.env.ADMIN_PASSWORD || 'admin';
    const passwordHash = bcrypt.hashSync(password, 10);
    db.set('admin', { username, passwordHash }).write();
    console.log(`[panel] کاربر ادمین اولیه ساخته شد → username: ${username}`);
  }
}

module.exports = { db, ensureAdmin };

const httpProxy = require('http-proxy');
const { INTERNAL_PORTS, WS_PATHS } = require('./xray/configBuilder');

const proxy = httpProxy.createProxyServer({ ws: true });

proxy.on('error', (err, req, res) => {
  console.error('[proxy] خطا:', err.message);
  if (res && res.writeHead) {
    res.writeHead(502);
    res.end('Bad gateway');
  }
});

function targetForPath(pathname) {
  if (pathname.startsWith(WS_PATHS.vless)) return `http://127.0.0.1:${INTERNAL_PORTS.vless}`;
  if (pathname.startsWith(WS_PATHS.vmess)) return `http://127.0.0.1:${INTERNAL_PORTS.vmess}`;
  if (pathname.startsWith(WS_PATHS.trojan)) return `http://127.0.0.1:${INTERNAL_PORTS.trojan}`;
  return null;
}

/**
 * روی سرور HTTP خام (http.createServer) صدا زده می‌شود تا رویداد
 * 'upgrade' (هندشیک وب‌ساکت) را به اینباند صحیح Xray فوروارد کند.
 */
function attachWsProxy(server) {
  server.on('upgrade', (req, socket, head) => {
    const target = targetForPath(req.url);
    if (!target) {
      socket.destroy();
      return;
    }
    proxy.ws(req, socket, head, { target });
  });
}

module.exports = { attachWsProxy };

const express = require('express');
const bcrypt = require('bcryptjs');
const { db } = require('../db');
const { signToken } = require('../auth');

const router = express.Router();

router.post('/login', (req, res) => {
  const { username, password } = req.body || {};
  if (!username || !password) {
    return res.status(400).json({ error: 'نام کاربری و رمز عبور الزامی است' });
  }

  const admin = db.get('admin').value();
  if (!admin || admin.username !== username) {
    return res.status(401).json({ error: 'نام کاربری یا رمز عبور اشتباه است' });
  }

  const ok = bcrypt.compareSync(password, admin.passwordHash);
  if (!ok) {
    return res.status(401).json({ error: 'نام کاربری یا رمز عبور اشتباه است' });
  }

  const token = signToken({ username: admin.username });
  res.json({ token });
});

module.exports = router;

const express = require('express');
const { db } = require('../db');
const { requireAuth } = require('../auth');
const { newClientId, newTrojanPassword, newSubToken } = require('../utils/id');
const { buildClientLink, buildSubscriptionPayload } = require('../utils/links');
const { syncXray } = require('../xray/runner');

const router = express.Router();

// همه‌ی روت‌های این فایل نیاز به لاگین ادمین دارند
router.use(requireAuth);

// لیست همه‌ی کلاینت‌ها به همراه لینک اتصال آماده
router.get('/', (req, res) => {
  const clients = db.get('clients').value();
  const withLinks = clients.map((c) => ({ ...c, link: buildClientLink(c) }));
  res.json(withLinks);
});

// ساخت کلاینت جدید
router.post('/', async (req, res) => {
  const { name, protocol, expiresAt, trafficLimitGB } = req.body || {};

  if (!name || !['vless', 'vmess', 'trojan'].includes(protocol)) {
    return res.status(400).json({ error: 'نام و پروتکل معتبر (vless/vmess/trojan) الزامی است' });
  }

  const client = {
    id: newSubToken(),
    subToken: newSubToken(),
    name,
    protocol,
    uuid: newClientId(),
    trojanPassword: newTrojanPassword(),
    enabled: true,
    expiresAt: expiresAt || null,
    trafficLimitGB: trafficLimitGB || null,
    createdAt: new Date().toISOString(),
  };

  db.get('clients').push(client).write();

  try {
    await syncXray();
  } catch (e) {
    // اگر روی خود سرور اجرا نشده باشد (مثلاً محیط تست) فقط لاگ می‌کنیم
    console.warn('[warn] sync با Xray انجام نشد:', e.message);
  }

  res.status(201).json({ ...client, link: buildClientLink(client) });
});

// فعال/غیرفعال کردن یا ویرایش یک کلاینت
router.patch('/:id', async (req, res) => {
  const { id } = req.params;
  const client = db.get('clients').find({ id }).value();
  if (!client) return res.status(404).json({ error: 'کلاینت پیدا نشد' });

  const allowed = ['name', 'enabled', 'expiresAt', 'trafficLimitGB'];
  const updates = {};
  for (const key of allowed) {
    if (key in (req.body || {})) updates[key] = req.body[key];
  }

  db.get('clients').find({ id }).assign(updates).write();

  try {
    await syncXray();
  } catch (e) {
    console.warn('[warn] sync با Xray انجام نشد:', e.message);
  }

  res.json(db.get('clients').find({ id }).value());
});

// حذف کلاینت
router.delete('/:id', async (req, res) => {
  const { id } = req.params;
  db.get('clients').remove({ id }).write();

  try {
    await syncXray();
  } catch (e) {
    console.warn('[warn] sync با Xray انجام نشد:', e.message);
  }

  res.status(204).end();
});

// لینک سابسکریپشن عمومی (بدون نیاز به لاگین، فقط با توکن مخفی هر کاربر)
// این روت در server.js جدا از requireAuth ثبت می‌شود.
function subscriptionHandler(req, res) {
  const { token } = req.params;
  const client = db.get('clients').find({ subToken: token }).value();
  if (!client) return res.status(404).send('not found');

  const payload = buildSubscriptionPayload(client);
  res.set('Content-Type', 'text/plain; charset=utf-8');
  res.send(payload);
}

module.exports = { router, subscriptionHandler };

