
# (نیازی به فایل .env روی خود Railway نیست، ولی برای اجرای لوکال مفید است)

# JWT_SECRET را حتماً به یک رشته‌ی تصادفی و طولانی تغییر دهید
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# اختیاری: اگر خالی بگذارید، از RAILWAY_PUBLIC_DOMAIN (که خود Railway ست می‌کند)
# استفاده می‌شود. بعداً هم می‌توانید از داخل خود پنل تغییرش دهید.
DOMAIN=

# توجه: PORT را Railway خودش ست می‌کند؛ نیازی به تنظیم دستی نیست.
# توجه: DATA_DIR را روی Railway حتماً به مسیر یک Volume متصل کنید (مثلا /app/data)
# تا با هر دیپلوی جدید، لیست کاربران پاک نشود.

FROM node:20-slim

# نصب ابزارهای لازم برای دانلود و آنزیپ Xray-core
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# نصب آخرین نسخه‌ی پایدار Xray-core (تگ لتست را از GitHub API می‌گیرد،
# پس با هر بیلد جدید خودش به‌روز می‌ماند و نیازی به هاردکد نسخه نیست)
RUN XRAY_TAG=$(curl -s https://api.github.com/repos/XTLS/Xray-core/releases/latest | grep -oP '"tag_name":\s*"\K[^"]+') \
    && echo "Installing Xray-core ${XRAY_TAG}" \
    && curl -L -o /tmp/xray.zip \
    "https://github.com/XTLS/Xray-core/releases/download/${XRAY_TAG}/Xray-linux-64.zip" \
    && unzip /tmp/xray.zip -d /usr/local/bin xray \
    && chmod +x /usr/local/bin/xray \
    && rm /tmp/xray.zip

ENV XRAY_BIN_PATH=/usr/local/bin/xray
ENV DATA_DIR=/app/data

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --omit=dev

COPY . .

RUN mkdir -p /app/data

EXPOSE 8080

CMD ["node", "server.js"]

