FROM node:18-slim

# نصب ابزارهای مورد نیاز
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# کپی فایل‌ها از پوشه پروژه
COPY vpn-panel-railway/package*.json ./
RUN npm install --production

COPY vpn-panel-railway/ ./

RUN mkdir -p /app/data

EXPOSE 3000

CMD ["npm", "start"]
